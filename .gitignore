# Environment variables and local secrets
/.env
/.env.*
!/.env.example
/auth.json
/.pypirc
/.netrc
/.git-credentials
/credentials.json
/secrets.json
/secrets.yaml
/secrets.yml
/id_rsa
/id_ed25519
*.pem
*.key
*.p12
*.pfx
*.mobileprovision

# Dependencies and generated frontend assets
/vendor
/node_modules
/public/build
/public/hot
/public/storage

# Local databases, exports, and backups
/database/*.sqlite
/database/*.sqlite-*
/database/*.db
/database/*.db-*
*.sql
*.sql.gz
*.sql.zip
*.dump
*.dump.gz
*.bak
*.backup
*.backup.*

# Laravel runtime data
/bootstrap/cache/*.php
/storage/*.key
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# Test and tool caches
/.phpunit.cache
/.phpunit.result.cache
/coverage
/build
/.cache
/.eslintcache
/.stylelintcache
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*

# Editor and operating-system files
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.orig

# Local hosting / VM configuration
/Homestead.json
/Homestead.yaml
